    "geoNotes": [
      {
        "country": "IN",
        "summary": "Cadence is law, not hygiene: the first board meeting within 30 days of incorporation and at least four a year (gap ≤ 120 days), run per ICSI Secretarial Standard SS-1 — small companies get a lighter two-meeting regime.",
        "actionUrl": "https://www.icsi.edu/",
        "actionLabel": "ICSI — secretarial standards"
      },
      {
        "country": "UK",
        "summary": "No statutory meeting cadence for private companies, but the Companies Act requires minutes of every board and shareholder decision kept for TEN years — written resolutions are the routine substitute for meetings.",
        "actionUrl": "https://www.gov.uk/running-a-limited-company",
        "actionLabel": "Running a limited company"
      }
    ],
