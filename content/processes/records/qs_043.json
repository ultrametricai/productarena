    "geoNotes": [
      {
        "country": "IN",
        "summary": "No agent industry: the analog is the registered office itself — declared at (or within 30 days of) incorporation via form INC-22 to the MCA (fronted by NSWS), with the company name displayed at the premises.",
        "actionUrl": "https://www.nsws.gov.in/",
        "actionLabel": "NSWS (MCA registered office — INC-22)"
      },
      {
        "country": "UK",
        "summary": "The analog is the registered office: since the 2023 ECCT Act it must be an 'appropriate address' where documents reliably reach the company (PO boxes alone are out), plus a registered email — agent-provided addresses remain fine.",
        "actionUrl": "https://www.gov.uk/limited-company-formation/company-address",
        "actionLabel": "Companies House — registered office rules"
      },
      {
        "country": "DE",
        "summary": "No registered-agent concept: the GmbH registers an inländische Geschäftsanschrift (domestic business address) in the Handelsregister where service of process is valid — keep it current via the notary when you move.",
        "actionUrl": "https://www.handelsregister.de/",
        "actionLabel": "Handelsregister (business address)"
      },
      {
        "country": "FR",
        "summary": "The analog is the siège social declared through the guichet unique: it can be the founder's home or a domiciliation company — the latter must hold a prefectural agrément — and changing it is a formal statuts amendment.",
        "actionUrl": "https://procedures.inpi.fr/",
        "actionLabel": "INPI guichet unique (siège social)"
      }
    ],
