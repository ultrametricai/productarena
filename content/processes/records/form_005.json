      {
        "country": "IN",
        "summary": "The state layer is real here: GST registration is per state of operation, and professional tax plus shops-and-establishments registration are state acts — the closest thing to US state tax registration.",
        "actionUrl": "https://www.gst.gov.in/",
        "actionLabel": "GST portal (per-state registration)"
      },
      {
        "country": "UK",
        "summary": "No states: registering for taxes means one national HMRC registration each — Corporation Tax (the UTR arrives automatically), PAYE when you employ, and VAT past the £90k threshold.",
        "actionUrl": "https://www.gov.uk/register-for-vat",
        "actionLabel": "HMRC — register for VAT"
      },
      {
        "country": "DE",
        "summary": "The sub-national layer is municipal: a Gewerbeanmeldung (trade registration) with each municipality you operate in, which drives Gewerbesteuer at that municipality's Hebesatz — plus the one federal tax-office registration via ELSTER.",
        "actionUrl": "https://www.existenzgruender.de/",
        "actionLabel": "BMWK founders portal (Gewerbeanmeldung)"
      },
      {
        "country": "FR",
        "summary": "Registrations are national and flow from the guichet unique filing; local business taxes (the CFE) are then assessed per commune automatically — nothing to register state-by-state.",
        "actionUrl": "https://www.impots.gouv.fr/professionnel",
        "actionLabel": "impots.gouv.fr — espace professionnel"
      }
