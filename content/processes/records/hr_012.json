    "supportReason": "Modern 401(k) providers onboard online and sync payroll automatically; the match decision and the plan adoption signature stay with the founder.",
    "region": "us",
    "geoScope": "us",
    "geoNotes": [
      {
        "country": "IN",
        "kind": "analog",
        "summary": "The EPF is the mandatory retirement vehicle once headcount crosses 20 — 12% of basic pay from employer and employee each, administered through the EPFO employer portal.",
        "actionUrl": "https://unifiedportal-emp.epfindia.gov.in/epfo/",
        "actionLabel": "EPFO — Employees' Provident Fund"
      },
      {
        "country": "UK",
        "kind": "analog",
        "summary": "Not optional like a 401(k): every UK employer must auto-enrol eligible staff into a workplace pension (8% minimum combined contribution) and declare compliance to The Pensions Regulator.",
        "actionUrl": "https://www.thepensionsregulator.gov.uk/en/employers",
        "actionLabel": "Pension auto-enrolment (The Pensions Regulator)"
      },
      {
        "country": "DE",
        "kind": "analog",
        "summary": "State pension contributions ride payroll automatically; the 401(k) analog is betriebliche Altersvorsorge — every employer MUST offer salary conversion (Entgeltumwandlung) with a 15% employer top-up when social charges are saved.",
        "actionUrl": "https://www.gesetze-im-internet.de/betravg/",
        "actionLabel": "BetrAVG — occupational pensions law"
      },
      {
        "country": "FR",
        "kind": "absorbed",
        "summary": "Mandatory complementary pensions (AGIRC-ARRCO) enroll automatically through payroll's DSN — nothing to set up; the optional analog is a PER d'entreprise (collective retirement savings plan) as a perk.",
        "actionUrl": "https://www.agirc-arrco.fr/",
        "actionLabel": "AGIRC-ARRCO complementary pension"
      },
      {
        "country": "PT",
        "kind": "absorbed",
        "summary": "State pension contributions ride the single social-security charge automatically and no occupational plan is mandated — a company PPR (retirement-savings plan) is a voluntary perk rather than an expected setup project.",
        "actionUrl": "https://www.seg-social.pt/empregadores",
        "actionLabel": "Segurança Social — empregadores"
      },
      {
        "country": "CA",
        "kind": "analog",
        "summary": "CPP rides payroll automatically; the 401(k) analog is the voluntary group RRSP or DPSP most tech employers offer (Quebec alone mandates offering a plan, the VRSP, for established employers with staff there).",
        "actionUrl": "https://www.canada.ca/en/services/taxes/savings-and-pension-plans/savings-and-pension-plan-administration.html",
        "actionLabel": "Savings and pension plan administration"
      }
