    "geoNotes": [
      {
        "country": "IN",
        "kind": "analog",
        "summary": "Onboarding a contractor means collecting their PAN and deducting TDS from every payment (s.194C/194J), depositing it monthly and reporting it quarterly — plus checking whether their GST registration applies to your invoices.",
        "actionUrl": "https://www.incometax.gov.in/iec/foportal/",
        "actionLabel": "Income Tax e-filing (TDS on fees)"
      },
      {
        "country": "UK",
        "kind": "analog",
        "summary": "Before the contract: an IR35/off-payroll status check (HMRC's CEST tool gives a rulable answer) — medium and large clients must issue a status determination statement, and misclassification lands the tax bill on you.",
        "actionUrl": "https://www.gov.uk/guidance/check-employment-status-for-tax",
        "actionLabel": "HMRC — check employment status (CEST)"
      },
      {
        "country": "DE",
        "kind": "analog",
        "summary": "The risk is Scheinselbständigkeit (false self-employment): a one-client contractor working like staff triggers retroactive social contributions — the DRV Clearingstelle runs an official status-determination procedure when in doubt.",
        "actionUrl": "https://www.deutsche-rentenversicherung.de/",
        "actionLabel": "Deutsche Rentenversicherung (status determination)"
      },
      {
        "country": "FR",
        "kind": "analog",
        "summary": "Contractors must be registered (micro-entrepreneur or company), and for contracts of €5,000+ you must collect and verify their URSSAF attestation de vigilance every six months — plus requalification risk if they work like an employee.",
        "actionUrl": "https://www.urssaf.fr/accueil/attestation-vigilance.html",
        "actionLabel": "URSSAF — attestation de vigilance"
      },
      {
        "country": "PT",
        "kind": "analog",
        "summary": "Contractors invoice through recibos verdes on the tax authority's portal, and the risk is falsos recibos verdes: the labour code presumes employment when the work looks like staff work, with retroactive contributions and fines on reclassification.",
        "actionUrl": "https://www.portaldasfinancas.gov.pt/",
        "actionLabel": "Portal das Finanças — recibos verdes"
      },
      {
        "country": "CA",
        "kind": "analog",
        "summary": "Status is decided on CRA's employee-vs-self-employed factors (guide RC4110): misclassify and the employer owes retroactive CPP and EI with penalties — settle the relationship's shape before the first invoice.",
        "actionUrl": "https://www.canada.ca/en/revenue-agency/services/forms-publications/publications/rc4110/employee-self-employed.html",
        "actionLabel": "CRA RC4110 — employee or self-employed"
      }
    ],
