    "geoScope": "global",
    "geoNotes": [
      {
        "country": "IN",
        "summary": "Assignments must be in writing and are read narrowly: the Copyright Act (s.19) voids assignments of unspecified future works and defaults unstated terms to five years — so PIIA-style blanket clauses need Indian-law drafting, plus moral-rights waivers.",
        "actionUrl": "https://copyright.gov.in/",
        "actionLabel": "Copyright Office India"
      },
      {
        "country": "DE",
        "summary": "A blanket PIIA cannot capture patents: the Arbeitnehmererfindungsgesetz gives employees rights in their inventions — the employer must actively claim each reported invention (deemed claimed after four months) and owes statutory compensation.",
        "actionUrl": "https://www.gesetze-im-internet.de/arbnerfg/",
        "actionLabel": "ArbnErfG — employee inventions act"
      },
      {
        "country": "FR",
        "summary": "Employee inventions follow Code de la propriété intellectuelle L611-7: 'mission' inventions belong to the employer but carry a mandatory rémunération supplémentaire, and copyright's moral rights are unwaivable — the INPI (home of the CNIS disputes commission) is the anchor.",
        "actionUrl": "https://www.inpi.fr/",
        "actionLabel": "INPI (employee inventions)"
      }
    ],
    "complexity": "moderate",
    "reversibility": "painful",
    "category": "ip_protection",
    "supportLevel": "partial",
    "supportReason": "System generates PIIAs from templates, tracks who has signed, sends via DocuSign. Legal review is person-routed.",
