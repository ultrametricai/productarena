    "geoNotes": [
      {
        "country": "IN",
        "summary": "Venture funds register with SEBI as Category I AIFs (VCF sub-category): a trust or LLP structure with a SEBI-registered manager, minimum corpus and investor-ticket floors, and ongoing SEBI reporting — registration precedes any fundraising.",
        "actionUrl": "https://www.sebi.gov.in/",
        "actionLabel": "SEBI — Alternative Investment Funds"
      },
      {
        "country": "UK",
        "summary": "The stack is an English (or Scottish) limited partnership — usually a PFLP — with a GP and an FCA-regulated manager: most emerging managers start as sub-threshold AIFMs registered with the FCA or operate under a regulatory host.",
        "actionUrl": "https://www.fca.org.uk/firms/authorisation",
        "actionLabel": "FCA — authorisation & registration"
      },
      {
        "country": "DE",
        "summary": "The standard vehicle is a GmbH & Co. KG with the manager registered at BaFin as a sub-threshold AIFM under § 2(4) KAGB — full authorization only kicks in past the AuM thresholds.",
        "actionUrl": "https://www.bafin.de/",
        "actionLabel": "BaFin (AIFM registration)"
      },
      {
        "country": "FR",
        "summary": "French venture vehicles are FPCIs (professional private-equity funds) run by an AMF-authorised (or registered) management company — AMF approval of the manager is the long pole in the schedule.",
        "actionUrl": "https://www.amf-france.org/",
        "actionLabel": "AMF — fund management authorisation"
      }
    ],
    "timeOrder": 120,
    "annoyance": 4,
    "risk": 5,
    "growthImpact": 1
  },
