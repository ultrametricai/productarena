      "mcp": "https://penpot.dev/ai/mcp-server"
    },
    "businessModel": {
      "models": ["open-source", "free-tier", "subscription-per-seat", "enterprise-custom"],
      "summary": "MPL-2.0 open source and free to self-host (official docker compose incl. a first-party MCP service); hosted SaaS has a free tier plus per-seat Unlimited/Enterprise plans and a private-server offering.",
      "url": "https://penpot.dev/pricing"
    },
    "install": [
      {
        "label": "docker",
        "command": "curl -o docker-compose.yaml https://raw.githubusercontent.com/penpot/penpot/main/docker/images/docker-compose.yaml && docker compose -p penpot -f docker-compose.yaml up -d",
        "url": "https://help.penpot.app/technical-guide/getting-started/"
      },
      {
        "label": "npm",
        "command": "npm install @penpot/plugin-types",
        "url": "https://help.penpot.app/plugins/"
      }
    ]
  },
