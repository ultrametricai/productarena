    },
    "businessModel": {
      "models": [
        "free-tier",
        "usage-based",
        "enterprise-custom"
      ],
      "summary": "Free tier (100k req/day); Paid plan is $5/mo minimum with included quota, then usage-based overages; Enterprise is custom-contract billed.",
      "url": "https://developers.cloudflare.com/workers/platform/pricing/"
    },
    "install": [
      {
        "label": "npm",
        "command": "npm i -D wrangler@latest",
        "url": "https://developers.cloudflare.com/workers/wrangler/install-and-update/"
      },
      {
        "label": "pnpm",
        "command": "pnpm add -D wrangler@latest",
        "url": "https://developers.cloudflare.com/workers/wrangler/install-and-update/"
      },
      {
        "label": "yarn",
        "command": "yarn add -D wrangler@latest",
        "url": "https://developers.cloudflare.com/workers/wrangler/install-and-update/"
      },
      {
        "label": "bun",
        "command": "bun add -d wrangler@latest",
        "url": "https://developers.cloudflare.com/workers/wrangler/install-and-update/"
      }
    ]
  },
