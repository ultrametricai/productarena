{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Founder Ops canonical rule",
  "type": "object",
  "required": ["id", "kind", "statement", "source_ids", "caveat", "jurisdiction", "version", "status", "reviewed_on", "review_due", "reviewer", "valid_from", "valid_until"],
  "properties": {
    "id": {"type": "string"}, "kind": {"enum": ["legal", "operating-practice"]},
    "statement": {"type": "string"}, "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "caveat": {"type": "string"}, "jurisdiction": {"type": "string"},
    "version": {"type": "string"}, "status": {"enum": ["draft", "demonstration", "reviewed", "deprecated"]},
    "reviewed_on": {"type": "string", "format": "date"}, "review_due": {"type": "string", "format": "date"},
    "reviewer": {"type": "string"}, "valid_from": {"type": ["string", "null"], "format": "date"},
    "valid_until": {"type": ["string", "null"], "format": "date"}
  },
  "additionalProperties": false
}
