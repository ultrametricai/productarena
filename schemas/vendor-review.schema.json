{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Founder Ops vendor evaluation",
  "type": "object",
  "required": ["id", "vendor", "category", "status", "jurisdictions", "tested_use_case", "tested_on", "reviewer", "affiliations", "evidence", "pricing", "dimensions", "limitations", "recheck_due"],
  "properties": {
    "id": {"type": "string"}, "vendor": {"type": "string"}, "category": {"type": "string"},
    "status": {"enum": ["unreviewed", "tested", "stale", "deprecated"]},
    "jurisdictions": {"type": "array", "items": {"type": "string"}},
    "tested_use_case": {"type": "string"}, "tested_on": {"type": ["string", "null"], "format": "date"},
    "reviewer": {"type": "string"}, "affiliations": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["kind", "uri", "observed_on"], "properties": {"kind": {"type": "string"}, "uri": {"type": "string"}, "observed_on": {"type": "string", "format": "date"}}}},
    "pricing": {"type": "object", "required": ["amount", "currency", "observed_on", "source"], "properties": {"amount": {"type": ["number", "null"]}, "currency": {"type": ["string", "null"]}, "observed_on": {"type": ["string", "null"], "format": "date"}, "source": {"type": ["string", "null"]}}},
    "dimensions": {"type": "object"}, "limitations": {"type": "array", "items": {"type": "string"}},
    "recheck_due": {"type": ["string", "null"], "format": "date"}
  },
  "additionalProperties": false
}
